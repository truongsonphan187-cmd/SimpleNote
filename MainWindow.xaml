<Window x:Class="SimpleNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleNote"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif"
        Loaded="Window_Loaded"
        MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Modern Glass Button Style -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D1D5DB"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#30FFFFFF"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#50FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tray Context Menu Dark Glassmorphism -->
        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="true"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border CornerRadius="12"
                                Background="#F214151C"
                                BorderBrush="#35FFFFFF"
                                BorderThickness="1"
                                Padding="6,6,6,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="itemBorder"
                                CornerRadius="7"
                                Padding="12,7,14,7"
                                Margin="0,1,0,1"
                                Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="iconPresenter" Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Path x:Name="checkGlyph"
                                      Grid.Column="0"
                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"
                                      Fill="#10B981"
                                      Stretch="Uniform"
                                      Width="12"
                                      Height="12"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="iconPresenter" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#20FFFFFF" Margin="6,4,6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Context Menu for System Tray -->
    <Window.ContextMenu>
        <ContextMenu x:Name="TrayMenu" Style="{StaticResource DarkContextMenu}" Opened="TrayMenu_Opened">
            <MenuItem Header="Toggle SimpleNote" Click="MenuToggle_Click" Style="{StaticResource DarkMenuItem}">
                <MenuItem.Icon>
                    <Path Data="M3 4h18v2H3V4zm0 7h18v2H3v-2zm0 7h18v2H3v-2z" Fill="#8B5CF6" Stretch="Uniform" Width="13" Height="13"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuPin" Header="Pin Scratchpad" Click="MenuPin_Click" Style="{StaticResource DarkMenuItem}">
                <MenuItem.Icon>
                    <Path Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z" Fill="#F59E0B" Stretch="Uniform" Width="13" Height="13"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MenuStartup" Header="Start with Windows" IsCheckable="True" Click="MenuStartup_Click" Style="{StaticResource DarkMenuItem}">
                <MenuItem.Icon>
                    <Path Data="M3 3h7v7H3V3zm9 0h7v7h-7V3zM3 12h7v7H3v-7zm9 0h7v7h-7v-7z" Fill="#6B7280" Stretch="Uniform" Width="12" Height="12"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Clear All Notes" Click="MenuClear_Click" Style="{StaticResource DarkMenuItem}">
                <MenuItem.Icon>
                    <Path Data="M15 4V3H9v1H4v2h1v13c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V6h1V4h-5zm2 15H7V6h10v13z" Fill="#EF4444" Stretch="Uniform" Width="13" Height="13"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource DarkMenuSeparator}"/>
            <MenuItem Header="Exit SimpleNote" Click="MenuExit_Click" Style="{StaticResource DarkMenuItem}">
                <MenuItem.Icon>
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#9CA3AF" Stretch="Uniform" Width="12" Height="12"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid x:Name="RootGrid">
        <!-- ======================================================== -->
        <!-- 1. COLLAPSED STATE: MINIMAL VERTICAL EDGE HANDLE         -->
        <!-- ======================================================== -->
        <!-- Visible edge pill body (Hit-test disabled to prevent accidental hover trigger) -->
        <Border x:Name="CollapsedHandle"
                Width="6"
                Height="170"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="6,0,0,6"
                Background="#800D0D11"
                BorderBrush="#40FFFFFF"
                BorderThickness="1,1,0,1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#000000" Opacity="0.4"/>
            </Border.Effect>
        </Border>

        <!-- Dedicated Invisible Edge Trigger Strip: Only triggers expansion when cursor hits the absolute extreme screen edge -->
        <Border x:Name="EdgeTriggerStrip"
                Width="2"
                Height="170"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                MouseEnter="EdgeTriggerStrip_MouseEnter"
                MouseLeftButtonDown="EdgeTriggerStrip_MouseLeftButtonDown"/>

        <!-- ======================================================== -->
        <!-- 2. EXPANDED STATE: FLOATING CARD + HIT-TEST BRIDGE       -->
        <!-- ======================================================== -->
        <Grid x:Name="ExpandedContainer"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              MouseEnter="ExpandedContainer_MouseEnter">
            <!-- Smooth slide-in/out transform -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" X="0" />
            </Grid.RenderTransform>

            <Grid.ColumnDefinitions>
                <!-- Main Note Card (Takes available width) -->
                <ColumnDefinition Width="*" />
                <!-- Hit-Test Bridge: Continuous invisible bridge between card and edge -->
                <ColumnDefinition Width="10" />
                <!-- Expanded Edge Tab (Flush against screen bezel) -->
                <ColumnDefinition Width="6" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Dark Acrylic Glassmorphism Note Card -->
            <Border Grid.Column="0"
                    CornerRadius="16"
                    Background="#E6101116"
                    BorderBrush="#30FFFFFF"
                    BorderThickness="1"
                    Margin="0,0,0,0"
                    ClipToBounds="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.65"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Note Editor Content Area -->
                        <RowDefinition Height="*"/>
                        <!-- Footer Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <Border Grid.Row="0"
                            Padding="16,14,14,12"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- App Identity & Status Indicator -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Modern Pencil/Note App Icon -->
                                <Border Width="24" Height="24" CornerRadius="6" Background="#268B5CF6" BorderBrush="#508B5CF6" BorderThickness="1" Margin="0,0,10,0">
                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                          Fill="#C4B5FD"
                                          Stretch="Uniform"
                                          Width="12"
                                          Height="12"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="SimpleNote"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           Foreground="#F3F4F6"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>



                                <!-- Quick "Copied!" Toast Badge (Animated) -->
                                <Border x:Name="ToastBadge"
                                        Opacity="0"
                                        Background="#268B5CF6"
                                        BorderBrush="#608B5CF6"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,2,8,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Copied to clipboard!"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#DDD6FE"/>
                                </Border>
                            </StackPanel>

                            <!-- Header Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- 📌 Pin Toggle Button -->
                                <Button x:Name="PinButton"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="PinButton_Click"
                                        ToolTip="Pin Open (Cross-reference notes while typing elsewhere)"
                                        Margin="0,0,6,0">
                                    <Path x:Name="PinIcon"
                                          Data="M16 12V4h1V2H7v2h1v8l-2 2v2h5.2v6h1.6v-6H18v-2l-2-2z"
                                          Fill="#9CA3AF"
                                          Stretch="Uniform"
                                          Width="12"
                                          Height="12"/>
                                </Button>

                                <!-- 📋 Copy All Button -->
                                <Button x:Name="CopyButton"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="CopyButton_Click"
                                        ToolTip="Copy all notes to clipboard"
                                        Margin="0,0,6,0">
                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                          Fill="#D1D5DB"
                                          Stretch="Uniform"
                                          Width="12"
                                          Height="12"/>
                                </Button>

                                <!-- 🧹 Clear All Notes Button -->
                                <Button x:Name="ClearButton"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="ClearButton_Click"
                                        ToolTip="Clear all notes"
                                        Margin="0,0,6,0">
                                    <Path Data="M15 4V3H9v1H4v2h1v13c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V6h1V4h-5zm2 15H7V6h10v13z"
                                          Fill="#D1D5DB"
                                          Stretch="Uniform"
                                          Width="11"
                                          Height="11"/>
                                </Button>

                                <!-- ✕ Collapse Button -->
                                <Button x:Name="CollapseButton"
                                        Style="{StaticResource HeaderIconButton}"
                                        Click="CollapseButton_Click"
                                        ToolTip="Collapse (Esc)">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                          Fill="#D1D5DB"
                                          Stretch="Uniform"
                                          Width="10"
                                          Height="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CONTENT: BULLET EDITOR & SMOOTH SCROLLING -->
                    <Grid Grid.Row="1" Margin="14,8,14,8">
                        <!-- Placeholder text when empty -->
                        <TextBlock x:Name="PlaceholderText"
                                   Text="Jot down a quick thought..."
                                   Foreground="#4B5563"
                                   FontSize="16.5"
                                   FontStyle="Italic"
                                   Margin="24,2,4,4"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>

                        <!-- Scratchpad Editor RichTextBox with Native FlowDocument List -->
                        <RichTextBox x:Name="NoteEditor"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#E5E7EB"
                                     CaretBrush="#A78BFA"
                                     SelectionBrush="#5B21B6"
                                     SelectionOpacity="0.6"
                                     FontSize="16.5"
                                     FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Disabled"
                                     AcceptsReturn="False"
                                     AcceptsTab="False"
                                     Padding="0"
                                     PreviewKeyDown="NoteEditor_PreviewKeyDown">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="LineHeight" Value="28"/>
                                </Style>
                                <Style TargetType="{x:Type List}">
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Padding" Value="24,0,0,0"/>
                                    <Setter Property="MarkerStyle" Value="Disc"/>
                                </Style>
                                <Style TargetType="{x:Type ListItem}">
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </RichTextBox.Resources>
                            <FlowDocument PagePadding="0"/>
                        </RichTextBox>
                    </Grid>

                    <!-- FOOTER BAR -->
                    <Border Grid.Row="2"
                            Padding="16,8,16,10"
                            BorderBrush="#14FFFFFF"
                            BorderThickness="0,1,0,0">
                        <!-- Live Note Counter -->
                        <TextBlock x:Name="StatsText"
                                   Text="0 bullets • 0 words"
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 1: Invisible Hit-Test Bridge -->
            <!-- Background="#00000000" covers gap to prevent premature MouseLeave -->
            <Border Grid.Column="1"
                    Background="#00000000"
                    Cursor="Arrow"/>

            <!-- Column 2: Edge Tab in Expanded State (Flush with screen edge) -->
            <Border Grid.Column="2"
                    Width="6"
                    Height="170"
                    VerticalAlignment="Center"
                    CornerRadius="6,0,0,6"
                    Background="#800D0D11"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1,1,0,1"
                    Cursor="Hand"
                    MouseLeftButtonDown="ExpandedHandle_MouseLeftButtonDown"/>
        </Grid>
    </Grid>
</Window>
